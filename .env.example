# Development defaults are intentionally not production secrets.
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DB_ENGINE=django.db.backends.postgresql
DB_NAME=prefixes_manager
DB_USER=prefixes_user
DB_PASSWORD=replace-me
DB_HOST=127.0.0.1
DB_PORT=5432
IPAM_SESSION_IDLE_TIMEOUT_SECONDS=1800
